# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (Neon console → Connection Details, pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Public URL of this app (no trailing slash). Must match the redirect URI registered in Zoho.
APP_URL=http://localhost:3000

# Zoho API Console (https://api-console.zoho.com) → "Server-based Applications"
# Authorized Redirect URI: ${APP_URL}/api/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# US data center (zoho.com)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com/workdrive/api/v1
ZOHO_DOWNLOAD_URL=https://download.zoho.com/v1/workdrive

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this OUT of the database (env var / secret manager only).
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# Temporary admin login until Phase 2 adds real user accounts.
ADMIN_PASSWORD=
