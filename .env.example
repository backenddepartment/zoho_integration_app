# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (Neon console → Connection Details, pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Every address this app is served from, comma-separated, no trailing slash.
# Register <each>/api/zoho/callback as an Authorized Redirect URI in the Zoho API Console.
APP_URL=http://localhost:3000,https://zoho-integration-app.vercel.app,https://workdrive.getmeds.ph

# Zoho API Console (https://api-console.zoho.com) → "Server-based Applications"
# Authorized Redirect URIs: <each APP_URL>/api/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Optional: a separate Zoho client for "Sign in with Zoho" (else the one above is used).
ZOHO_LOGIN_CLIENT_ID=
ZOHO_LOGIN_CLIENT_SECRET=
# US data center (zoho.com)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com/workdrive/api/v1
ZOHO_DOWNLOAD_URL=https://download.zoho.com/v1/workdrive

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this OUT of the database (env var / secret manager only).
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# Scheduled WorkDrive scans (vercel.json → /api/cron/sync, 6 AM and 3 PM Philippine time).
# Any random string of 16+ characters; Vercel sends it as "Authorization: Bearer <value>".
CRON_SECRET=
